# PostgreSQL
DB_URL=jdbc:postgresql://localhost:15433/triage
DB_USERNAME=triage
DB_PASSWORD=triage

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ai-triage-service
KAFKA_TOPIC_TICKET_MANAGEMENT_EVENTS=ticket-management-events
KAFKA_TOPIC_KNOWLEDGE_BASE_EVENTS=knowledge-base-events
KAFKA_TOPIC_ORGANIZATION_ACCESS_EVENTS=organization-access-events
KAFKA_TOPIC_AI_TRIAGE_EVENTS=ai-triage-events
KAFKA_TOPIC_AI_TRIAGE_DLT=ai-triage-events-dlt

# OpenAI
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key

# RAG
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_MAX_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=200
RAG_INDEXING_ENABLED=true
RAG_RETRIEVAL_TOP_K=30
RAG_RETRIEVAL_MAX_ARTICLES=3
RAG_RETRIEVAL_MAX_EXPANDED_QUERIES=3
RAG_RETRIEVAL_SIMILARITY_THRESHOLD=0.45

# Ticket analysis pipeline
TICKET_ANALYSIS_ENABLED=true

# AI adapters
TAG_SUGGESTION_PROVIDER=openai
TAG_SUGGESTION_MODEL=gpt-5.4-mini
TAG_SUGGESTION_MAX_OUTPUT_TOKENS=1000
TAG_SUGGESTION_SAFE_LOGGING_ENABLED=true

ANSWER_GENERATION_PROVIDER=openai
ANSWER_GENERATION_MODEL=gpt-5.4-mini
ANSWER_GENERATION_MAX_OUTPUT_TOKENS=2500
ANSWER_GENERATION_SAFE_LOGGING_ENABLED=true
