# PostgreSQL
DB_URL=jdbc:postgresql://localhost:15433/triage
DB_USERNAME=triage_user
DB_PASSWORD=change-me-local-triage-password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=ai-triage-service
KAFKA_TOPIC_TICKET_MANAGEMENT_EVENTS=ticket-management-events
KAFKA_TOPIC_KNOWLEDGE_BASE_EVENTS=knowledge-base-events
KAFKA_TOPIC_ORGANIZATION_ACCESS_EVENTS=organization-access-events
KAFKA_TOPIC_AI_TRIAGE_EVENTS=ai-triage-events
KAFKA_TOPIC_AI_TRIAGE_DLT=ai-triage-events-dlt

# Outbound triage event contracts
EVENT_AI_ANALYSIS_COMPLETED=AiAnalysisCompleted
EVENT_AI_ANALYSIS_FAILED=AiAnalysisFailed

# Inbound ticket-management event contracts
EVENT_TAG_CREATED=TagCreated
EVENT_TAG_DELETED=TagDeleted
EVENT_TAG_AI_SETTING_UPDATED=TagAISettingUpdated

# Inbound knowledge-management event contracts
EVENT_KNOWLEDGE_ARTICLE_APPROVED=KnowledgeArticleApproved
EVENT_KNOWLEDGE_ARTICLE_DRAFT_SAVED=KnowledgeArticleDraftSaved
EVENT_KNOWLEDGE_ARTICLE_DRAFT_SAVE_FAILED=KnowledgeArticleDraftSaveFailed
EVENT_KNOWLEDGE_ARTICLE_REJECTED=KnowledgeArticleRejected

# Topic provisioning
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICAS=1
KAFKA_TOPIC_MIN_ISR=1

# Spring AI / OpenAI
SPRING_AI_CHAT_MODEL=none
SPRING_AI_EMBEDDING_MODEL=openai-sdk
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key

# RAG indexing
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_MAX_CHARS=1800
RAG_CHUNK_OVERLAP_CHARS=200
RAG_INDEXING_ENABLED=true
RAG_INDEXING_BATCH_SIZE=25
RAG_INDEXING_MAX_ATTEMPTS=5
RAG_INDEXING_POLL_DELAY_MS=5000
RAG_INDEXING_LOCK_AT_MOST_FOR=PT2M
RAG_INDEXING_LOCK_AT_LEAST_FOR=PT0S
RAG_INDEXING_STUCK_TIMEOUT=PT10M
RAG_RETRIEVAL_TOP_K=30
RAG_RETRIEVAL_MAX_ARTICLES=3
RAG_RETRIEVAL_MAX_EXPANDED_QUERIES=3
RAG_RETRIEVAL_SIMILARITY_THRESHOLD=0.45

# Ticket analysis pipeline
TICKET_ANALYSIS_ENABLED=true
TICKET_ANALYSIS_BATCH_SIZE=10
TICKET_ANALYSIS_MAX_ATTEMPTS=3
TICKET_ANALYSIS_POLL_DELAY_MS=5000
TICKET_ANALYSIS_LOCK_AT_MOST_FOR=PT2M
TICKET_ANALYSIS_LOCK_AT_LEAST_FOR=PT0S
TICKET_ANALYSIS_STUCK_TIMEOUT=PT10M

# AI adapters
TAG_SUGGESTION_PROVIDER=stub
TAG_SUGGESTION_MODEL=gpt-5.4-mini
TAG_SUGGESTION_MAX_OUTPUT_TOKENS=1000
TAG_SUGGESTION_SAFE_LOGGING_ENABLED=true

ANSWER_GENERATION_PROVIDER=stub
ANSWER_GENERATION_MODEL=gpt-5.4-mini
ANSWER_GENERATION_MAX_OUTPUT_TOKENS=2500
ANSWER_GENERATION_SAFE_LOGGING_ENABLED=true
